# ===== DocMind 环境变量模板 =====
# 复制本文件为 .env 并填入真实 key（.env 已被 .gitignore 排除，切勿提交）

# DeepSeek 大模型（https://platform.deepseek.com 注册，充值几元即可）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# 硅基流动 Embedding / 重排模型（https://siliconflow.cn 注册，有免费额度）
SILICONFLOW_API_KEY=sk-your-siliconflow-key

# ---- 以下为可选覆盖项（默认值已内置在 app/config.py）----
# DEEPSEEK_MODEL=deepseek-chat
# EMBEDDING_MODEL=BAAI/bge-m3
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# TOP_K=5
# MAX_UPLOAD_MB=20

# ---- 压测 / 性能调试（默认全真；压测场景 2 三行全开 mock 离线跑）----
# LLM_PROVIDER=mock            # deepseek | mock
# EMBEDDING_PROVIDER=mock      # siliconflow | mock
# RERANK_PROVIDER=mock         # siliconflow | mock
# PERF_LOG=1                   # 分段计时日志（定位延迟瓶颈）
